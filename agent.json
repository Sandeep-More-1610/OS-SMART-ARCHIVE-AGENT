{
  "agent_id": 12,
  "name": "smart_archive_agent",
  "display_name": "Smart Archive Agent",
  "version": "1.0.0",
  "description": "Creates archives (tar, tar.gz, tar.bz2, tar.xz, zip), compresses and decompresses single files (gzip, bzip2, xz), lists, inspects and safely extracts archives, and encrypts or decrypts files with GPG AES-256. Understands compression strength words such as 'heavily' or 'quickly'. Does not search for files, delete or shred files, rotate logs or free disk space.",
  "team": [
    "Kush Aghera (24BCE0149)",
    "Sandeep More (24BCE2883)"
  ],
  "routing_keywords": [
    "archive",
    "zip",
    "unzip",
    "tar",
    "tarball",
    "compress",
    "decompress",
    "extract",
    "unpack",
    "backup",
    "bundle",
    "gzip",
    "bzip2",
    "xz",
    "encrypt",
    "decrypt",
    "gpg",
    "password-protect"
  ],
  "example_prompts": [
    "Zip up my project folder, compress it heavily, and encrypt it.",
    "extract ./backup.tar.xz into ./restored",
    "what is inside ./photos.zip",
    "decrypt ./project.tar.xz.gpg and extract it"
  ],
  "python_api": {
    "import": "import smart_archive_agent",
    "get_tools": "smart_archive_agent.get_tools(style='generic'|'openai'|'anthropic', prefixed=False)",
    "execute_tool": "smart_archive_agent.execute_tool(name, args, passphrase=None) -> dict",
    "handle_request": "smart_archive_agent.handle_request(text, confirm=None, passphrase=None) -> dict"
  },
  "command_line": "smart-archive-agent [--yes] [\"request\"] | --doctor | --manifest",
  "tools": [
    "create_archive",
    "extract_archive",
    "list_archive",
    "inspect_archive",
    "compress_file",
    "decompress_file",
    "encrypt_file",
    "decrypt_file"
  ],
  "prefixed_tool_names": [
    "smart_archive__create_archive",
    "smart_archive__extract_archive",
    "smart_archive__list_archive",
    "smart_archive__inspect_archive",
    "smart_archive__compress_file",
    "smart_archive__decompress_file",
    "smart_archive__encrypt_file",
    "smart_archive__decrypt_file"
  ],
  "requirements": {
    "python": ">=3.8",
    "python_packages": [],
    "system_commands": [
      "tar",
      "gzip",
      "bzip2",
      "xz",
      "gpg",
      "file"
    ],
    "apt_install": "sudo apt install -y tar gzip bzip2 xz-utils gnupg file",
    "windows": {
      "archive_backend": "Python standard library",
      "system_commands": [
        "gpg (encryption/decryption only)"
      ],
      "gpg_discovery": "PATH, GnuPG or Git for Windows installation"
    }
  },
  "needs_root": false,
  "secrets": "encrypt_file / decrypt_file need a passphrase, passed as execute_tool(..., passphrase=...) or typed at a hidden prompt; it must never come from the LLM.",
  "result_format": {
    "success": "bool",
    "operation": "str",
    "message": "str",
    "output": "str (optional)",
    "error": "str (on failure)"
  }
}
